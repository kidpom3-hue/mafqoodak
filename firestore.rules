rules_version = '2';

// قواعد حماية بيانات مفقودك — الإصدار v11 (H16: النقود لا تُعرض للزائر؛ v10 (H14): موافقة واحدة لكل الطلبات؛ v9 (H12): إصلاحات أمنية؛ v8: الطلب بالوصف؛ v7: تقوية إثبات الملكية؛ v6: فحص أمني H7)
// انسخ هذا الملف كاملاً إلى Firebase Console ← Firestore Database ← Rules ثم اضغط Publish.
//
// الأدوار:
//   المالك/الإدارة  : وثيقة في admins/{uid}
//   موظف المكتب     : وثيقة في staff/{uid} فيها قائمة offices بالمكاتب المسموحة
//   الزائر المسجّل   : أي مستخدم سجّل دخوله
//   الزائر غير المسجّل: يتصفح المواقع والمفقودات فقط

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function isStaffAny() { return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/staff/$(me()))); }
    function isStaffOf(officeId) {
      return isAdmin() || (
        signedIn()
        && exists(/databases/$(database)/documents/staff/$(me()))
        && officeId in get(/databases/$(database)/documents/staff/$(me())).data.offices
      );
    }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // بريد موثّق: حساب Google موثّق تلقائياً، وحساب البريد وكلمة المرور بعد الضغط على رابط التحقق
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    // دعوة الموظف: معرّفها البريد بأحرف صغيرة. تُقرأ ببريد الحساب الموثّق نفسه فقط
    function myEmail() { return request.auth.token.email.lower(); }
    function hasEmail() { return verified() && ('email' in request.auth.token) && request.auth.token.email is string; }
    function inviteDoc() { return /databases/$(database)/documents/staffInvites/$(myEmail()); }
    function invited() { return hasEmail() && exists(inviteDoc()); }

    // ── حراسة سلسلة الحيازة على الخادم ──
    // قبول طلب: الغرض متاح قبل العملية، ويصبح محجوزاً لهذا الطلب في العملية نفسها (يمنع قبول طلبين معاً من جهازين)
    function approveOk(claimId, itemId) {
      return get(/databases/$(database)/documents/items/$(itemId)).data.status == 'available'
        && getAfter(/databases/$(database)/documents/items/$(itemId)).data.reservedFor == claimId;
    }
    // التسليم بالرمز: الغرض محجوز لهذا الطلب قبل العملية، ويصبح «سُلّم» في العملية نفسها
    function doneOk(claimId, itemId) {
      return get(/databases/$(database)/documents/items/$(itemId)).data.reservedFor == claimId
        && getAfter(/databases/$(database)/documents/items/$(itemId)).data.status == 'returned';
    }
    // ── H7 (v6): أنواع الحقول، حتى لا تُعطِّل بيانات تالفة صفحات الموظف ──
    // تاريخ يوم: غير موجود، أو فارغ، أو بصيغة YYYY-MM-DD فقط
    function isDay(d, k) { return !(k in d) || d[k] == '' || (d[k] is string && d[k].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')); }
    // وقت بالمللي ثانية: غير موجود، أو رقم
    function ts(d, k) { return !(k in d) || d[k] is number; }
    // وقت يُكتب في هذه العملية: رقم قريب من وقت الخادم (±يوم واحد)، فلا يُكتب وقت مستقبلي بعيد مثل 9e15
    function fresh(d, k) {
      return (k in d) && d[k] is number
        && d[k] > request.time.toMillis() - 86400000 && d[k] < request.time.toMillis() + 86400000;
    }
    // عند التعديل: الوقت إما لم يتغير، أو تغيّر إلى وقت «الآن»
    function freshIfChanged(k) { return request.resource.data.get(k, null) == resource.data.get(k, null) || fresh(request.resource.data, k); }
    function officeExists(id) { return id is string && exists(/databases/$(database)/documents/offices/$(id)); }
    function catOk(d) { return d.cat is string && d.cat.size() <= 40; }
    // حدّ الإغراق: rate/{uid} يُكتب بوقت الخادم مع كل إنشاء (بلاغ، إشعار تسليم، طلب استلام)،
    // والإنشاء مرفوض إن كان الإنشاء السابق لهذا الحساب قبل أقل من 20 ثانية
    function rateDoc() { return /databases/$(database)/documents/rate/$(me()); }
    function rateOk() {
      return getAfter(rateDoc()).data.at == request.time
        && (!exists(rateDoc()) || get(rateDoc()).data.at < request.time - duration.value(20, 's'));
    }
    // ── v7: تقوية إثبات الملكية ──
    // الأغراض الثمينة (نفس القائمة HIGH_VALUE في js/constants.js — عدّلهما معاً)
    // v10 (H14): للتسليم المباشر والحذف بصلاحية الإدارة فقط. القبول بموظف واحد لكل التصنيفات
    function highValue() { return ['cash', 'phones', 'jewelry', 'ids', 'wallets']; }
    function claimDoc(id) { return /databases/$(database)/documents/claims/$(id); }
    // ── v8 (H11): الطلب المجمّع (بالوصف، بلا اختيار غرض) للتصنيفات ذات العنوان العام العام
    // (نفس القائمة GROUP_CATS في js/constants.js — عدّلهما معاً)
    function groupCats() { return ['cash', 'ids', 'wallets', 'keys']; }
    function linkDoc(id) { return /databases/$(database)/documents/claimLinks/$(id); }
    // ── v11 (H16): تصنيفات لا تُعرض للزائر أبداً (نفس القائمة HIDDEN_CATS في js/constants.js — عدّلهما معاً)
    // كل غرض فيه حقل public: true للعادي، و false لهذه التصنيفات (القواعد تفرضه عند الكتابة).
    // الغرض القديم بلا الحقل: عام إلا إن كان من هذه التصنيفات. الزائر يستعلم بـ public == true فقط
    function hiddenCats() { return ['cash']; }
    // (الفرع الأول وحده يثبته استعلام الزائر public == true؛ والثاني للقراءة المباشرة لغرض قديم لم يُرحَّل بعد)
    function isPublicItem(d) { return d.public == true || (!('public' in d) && !(d.cat in hiddenCats())); }
    function publicOk(d) { return d.get('public', true) == !(d.cat in hiddenCats()); }
    // صاحب طلب على الغرض: طلب مباشر بمعرّف {itemId}_{uid}، أو طلب مجمّع حُجز له الغرض (reservedFor)
    function claimantOf(itemId) {
      return signedIn() && (exists(claimDoc(itemId + '_' + me()))
        || (resource.data.get('reservedFor', '') != '' && exists(claimDoc(resource.data.reservedFor))
            && get(claimDoc(resource.data.reservedFor)).data.uid == me()));
    }
    // ── v9 (H12): رمز الاستلام يُفحص على الخادم ──
    // بصمة الرمز في claimCodes/{claimId} (لا يقرؤها أحد)، والموظف يكتب الرمز الذي قدّمه المستلم في handoverCode
    // عند التسليم؛ القواعد تحسب sha256(رقم الطلب:الرمز) وتقارنها. الطلبات القديمة (قبل v9): البصمة في codeHash بالطلب نفسه
    function codeDoc(id) { return /databases/$(database)/documents/claimCodes/$(id); }
    // v9: غرض يحذفه موظف المكتب (غير الإدارة): مثال، أو متاح سُجّل قبل أقل من 24 ساعة وليس ثميناً
    function deletable(d) {
      return d.get('sample', false) == true
        || (d.status == 'available' && d.createdAt is number && d.createdAt > request.time.toMillis() - 86400000
            && !(d.cat in highValue()));
    }
    function itemGone(itemId) { return !exists(/databases/$(database)/documents/items/$(itemId)); }
    function itemDeletable(itemId) {
      return itemGone(itemId) || deletable(get(/databases/$(database)/documents/items/$(itemId)).data);
    }
    function codeOk(claimId) {
      return request.resource.data.handoverCode is string && request.resource.data.handoverCode.size() <= 16
        && hashing.sha256(claimId + ':' + request.resource.data.handoverCode).toHexString().lower()
           == (exists(codeDoc(claimId)) ? get(codeDoc(claimId)).data.hash : resource.data.get('codeHash', '-'));
    }
    // بريد الكلية: إن كان للمكتب نمط نطاقات (claimDomainRe يحسبه التطبيق من claimDomains) فالبريد الموثّق يطابقه
    function domainOk(officeId) {
      return get(/databases/$(database)/documents/offices/$(officeId)).data.get('claimDomainRe', '') == ''
        || (('email' in request.auth.token) && request.auth.token.email is string
            && request.auth.token.email.lower().matches(get(/databases/$(database)/documents/offices/$(officeId)).data.claimDomainRe));
    }
    function smallImage() { return request.resource.data.data is string && request.resource.data.data.size() < 350000; }

    // ── حدود البيانات: تمنع كتابة حقول غريبة أو نصوص ضخمة تستهلك حصة الخطة المجانية ──
    // الحدود هنا أكبر من حدود النماذج في التطبيق بهامش واسع، فلا تؤثر على الاستخدام العادي.
    function strMax(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function photoDoc() { return request.resource.data.keys().hasOnly(['data']) && smallImage(); }
    // تفاصيل الغرض السرية: لا تُكتب أبداً في items (المقروءة للجميع)، مكانها itemSecrets
    // spot (مكان العثور) سري أيضاً: هو نفسه جواب «أين فقدته؟» في طلب الاستلام، فما يراه الزائر لا يُحسب دليلاً
    function secretKeys() { return ['color', 'brand', 'desc', 'bldg', 'room', 'storage', 'details', 'spot']; }
    // إجابات أسئلة التصنيف (المبلغ، عدد المفاتيح، خلفية الشاشة…): خريطة نصوص قصيرة بمفاتيح معروفة فقط
    // (نفس القائمة في DETAIL_KEYS في js/constants.js — عدّلهما معاً)
    function detailKeys() {
      return ['amount', 'denoms', 'holder', 'docName', 'docLast4', 'issuer', 'cardName', 'cashInside', 'model', 'lockscreen',
              'mark', 'keyCount', 'keyring', 'carBrand', 'engraving', 'size', 'caseDesc', 'inside', 'bookName', 'nameOn'];
    }
    function validDetails(d) {
      return !('details' in d) || (d.details is map
        && d.details.keys().hasOnly(detailKeys())
        && d.details.size() <= 8
        // كل القيم نصوص، ومجموع أطوالها محدود
        && d.details.values().join('').size() <= 1200);
    }
    function validSecret(d) {
      return d.keys().hasOnly(['officeId', 'title', 'color', 'brand', 'desc', 'bldg', 'room', 'storage', 'handoverNote', 'disposalNote', 'finderNote', 'details', 'spot'])
        && d.officeId is string && validDetails(d)
        && strMax(d, 'title', 400) && strMax(d, 'color', 60) && strMax(d, 'brand', 200) && strMax(d, 'desc', 4000)
        && strMax(d, 'bldg', 40) && strMax(d, 'room', 60) && strMax(d, 'storage', 200)
        && strMax(d, 'handoverNote', 600) && strMax(d, 'disposalNote', 600) && strMax(d, 'finderNote', 300)
        && strMax(d, 'spot', 400);
    }

    function validUser(d) {
      return d.keys().hasOnly(['name', 'email', 'photo', 'lastSeen', 'lang'])
        && strMax(d, 'name', 200) && strMax(d, 'email', 320)
        // H7: البريد (يراه الموظف ويثق به) = بريد الحساب نفسه فقط
        && (!('email' in d) || d.email == request.auth.token.email)
        && (!('lang' in d) || d.lang in ['ar', 'en'])
        // صورة الملف الشخصي: فارغة أو من صور حسابات Google فقط (تمنع روابط التتبّع)
        && (!('photo' in d) || d.photo == ''
            || (d.photo is string && d.photo.size() <= 2000
                && d.photo.matches('https://[a-z0-9.-]+[.]googleusercontent[.]com/.*')));
    }

    function validReport(d) {
      return d.keys().hasOnly(['officeId', 'uid', 'cat', 'sub', 'color', 'title', 'desc', 'spot', 'bldg', 'room',
                               'lostDate', 'photo', 'status', 'createdAt', 'closedAt', 'renewedAt', 'ai', 'staffPick', 'pickedAt',
                               'details', 'closedReason', 'pickRejected', 'rejected', 'editedAt'])
        && d.officeId is string && d.status in ['open', 'closed']
        && validDetails(d)
        // سبب الإغلاق: وجده صاحبه بنفسه، أو استلمه من المكتب
        && (!('closedReason' in d) || d.closedReason in ['self', 'office'])
        && strMax(d, 'pickRejected', 100)
        // «ليس غرضي»: قائمة أرقام الأغراض التي رفضها صاحب البلاغ (30 على الأكثر)
        && (!('rejected' in d) || (d.rejected is list && d.rejected.size() <= 30))
        // وقت آخر تعديل من صاحب البلاغ
        && (!('editedAt' in d) || d.editedAt is number)
        // H7: تاريخ الفقدان بصيغة يوم، والأوقات أرقام
        && isDay(d, 'lostDate') && ts(d, 'createdAt') && ts(d, 'closedAt') && ts(d, 'renewedAt') && ts(d, 'pickedAt')
        && strMax(d, 'title', 400) && strMax(d, 'desc', 4000) && strMax(d, 'sub', 200) && strMax(d, 'color', 60)
        && strMax(d, 'spot', 400) && strMax(d, 'bldg', 40) && strMax(d, 'room', 60)
        // v9: نتيجة المطابقة الذكية: الوقت والقائمة فقط (10 على الأكثر)
        && (!('ai' in d) || (d.ai is map && d.ai.keys().hasOnly(['at', 'matches'])
            && (!('matches' in d.ai) || (d.ai.matches is list && d.ai.matches.size() <= 10))));
    }

    // إعداد التطبيق: أول مستخدم يُكمل الإعداد يصبح المالك
    match /config/app {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/config/app)
        && request.resource.data.ownerUid == me();
      allow update: if isAdmin() && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    match /admins/{userId} {
      allow read: if signedIn() && (userId == me() || isAdmin());
      allow create: if isAdmin() || (
        userId == me()
        && !exists(/databases/$(database)/documents/config/app)
        && getAfter(/databases/$(database)/documents/config/app).data.ownerUid == me()
      );
      // لا يمكن حذف المالك أو تعديله
      allow update, delete: if isAdmin()
        && userId != get(/databases/$(database)/documents/config/app).data.ownerUid;
    }


    // الملف العام للمستخدم (الاسم والصورة): يقرؤه صاحبه، والموظفون لعرض اسم صاحب الطلب
    match /users/{userId} {
      allow get: if signedIn() && (userId == me() || isStaffAny());
      // عرض قائمة كل المستخدمين (وفيها البريد) للإدارة فقط
      allow list: if isAdmin();
      allow create, update: if signedIn() && userId == me() && validUser(request.resource.data);
      // «حذف حسابي»: يحذف المستخدم ملفه بنفسه
      allow delete: if signedIn() && userId == me();

      // رموز الاستلام الخاصة: لا يراها أحد غير صاحبها
      match /private/{docId} {
        allow read, write: if signedIn() && userId == me();
      }
    }

    match /offices/{officeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // المفقودات: يراها الجميع، ويعدّلها موظفو المكتب نفسه فقط
    // v11 (H16): إلا النقود: لموظف المكتب والإدارة، ولصاحب طلب عليها فقط (لا تظهر في أي قائمة أو رابط للزائر)
    match /items/{itemId} {
      allow read: if isPublicItem(resource.data) || isStaffOf(resource.data.officeId) || claimantOf(itemId);
      allow create: if isStaffOf(request.resource.data.officeId)
        && !request.resource.data.keys().hasAny(secretKeys())
        && request.resource.data.public == !(request.resource.data.cat in hiddenCats());
      allow update: if isStaffOf(resource.data.officeId)
        && request.resource.data.officeId == resource.data.officeId
        && !request.resource.data.keys().hasAny(secretKeys())
        // v11: public يطابق التصنيف بعد كل تعديل (تغيير التصنيف إلى نقود يجعله خاصاً في العملية نفسها)
        && publicOk(request.resource.data)
        // «محجوز» فقط لطلب مقبول في العملية نفسها
        && (request.resource.data.status != 'reserved' || resource.data.status == 'reserved'
            || getAfter(/databases/$(database)/documents/claims/$(request.resource.data.reservedFor)).data.status == 'approved')
        // «سُلّم» فقط بطلب اكتمل بالرمز، أو بتسليم مباشر موثّق باسم المستلم في التفاصيل السرية
        && (request.resource.data.status != 'returned' || resource.data.status == 'returned'
            || getAfter(/databases/$(database)/documents/claims/$(resource.data.get('reservedFor', '-'))).data.status == 'done'
            // v9: التسليم المباشر لغرض ثمين (بلا رمز استلام): للإدارة فقط
            || (getAfter(/databases/$(database)/documents/itemSecrets/$(itemId)).data.get('handoverNote', '') != ''
                && (isAdmin() || !(resource.data.cat in highValue()))))
        // v9: حماية الحجز: غرض محجوز لطلب لا يُفك حجزه (تغيير reservedFor أو الخروج من «محجوز»)
        // ما دام ذلك الطلب «مقبولاً» بعد العملية؛ أي يُغلق الطلب (رفض، انتهاء، تسليم) في العملية نفسها
        && (resource.data.get('reservedFor', '') == ''
            || (request.resource.data.get('reservedFor', '') == resource.data.reservedFor && request.resource.data.status == 'reserved')
            || !existsAfter(claimDoc(resource.data.reservedFor))
            || getAfter(claimDoc(resource.data.reservedFor)).data.status != 'approved');
      // v9: الحذف للإدارة، أو لموظف المكتب إذا كان مثالاً، أو متاحاً سُجّل قبل أقل من 24 ساعة وليس ثميناً (خطأ إدخال)
      allow delete: if isAdmin() || (isStaffOf(resource.data.officeId) && deletable(resource.data));
    }

    // التفاصيل السرية للغرض (اللون، الماركة، الوصف، مكان العثور والمبنى والقاعة، موضع الحفظ): لموظفي مكتبه فقط
    match /itemSecrets/{itemId} {
      allow read: if isStaffOf(resource.data.officeId);
      allow create: if isStaffOf(request.resource.data.officeId)
        && validSecret(request.resource.data)
        && get(/databases/$(database)/documents/items/$(itemId)).data.officeId == request.resource.data.officeId;
      allow update: if isStaffOf(resource.data.officeId)
        && request.resource.data.officeId == resource.data.officeId
        && validSecret(request.resource.data);
      // v9: التفاصيل السرية تُحذف مع غرضها فقط، وبشرط حذفه نفسه (فلا يمحو موظف أدلة غرض ثمين)
      allow delete: if isAdmin() || (isStaffOf(resource.data.officeId) && itemDeletable(itemId));
    }

    // الصورة الأصلية الواضحة: لموظفي المكتب فقط (العامة في itemPhotos: واضحة أو مموّهة أو غير موجودة حسب اختيار الموظف)
    match /itemPhotosPrivate/{itemId} {
      allow read: if isStaffOf(resource.data.officeId);
      allow create, update: if isStaffOf(request.resource.data.officeId)
        && request.resource.data.keys().hasOnly(['officeId', 'data']) && smallImage()
        && get(/databases/$(database)/documents/items/$(itemId)).data.officeId == request.resource.data.officeId;
      // الأصل الواضح: يُحذف عند إزالة الصورة من غرض موجود، أو مع الغرض بشرط حذفه (v9)
      allow delete: if isStaffOf(resource.data.officeId);
    }

    match /itemPhotos/{itemId} {
      function itemOffice() { return get(/databases/$(database)/documents/items/$(itemId)).data.officeId; }
      allow read: if true;
      // v11: لا صورة عامة لغرض من التصنيفات المخفية
      allow create, update: if photoDoc() && isStaffOf(itemOffice())
        && !(get(/databases/$(database)/documents/items/$(itemId)).data.cat in hiddenCats());
      // موظف المكتب يحذف صور مفقودات مكتبه فقط
      allow delete: if isAdmin() || isStaffOf(itemOffice());
    }

    // بلاغات المفقودات: يراها صاحبها وموظفو المكتب
    match /reports/{reportId} {
      allow read: if signedIn() && (resource.data.uid == me() || isStaffOf(resource.data.officeId));
      allow create: if verified()
        && request.resource.data.uid == me()
        && request.resource.data.status == 'open'
        && validReport(request.resource.data)
        // H7: المكتب موجود، والتصنيف نص قصير، ووقت الإنشاء «الآن»، وحدّ الإغراق
        && officeExists(request.resource.data.officeId) && catOk(request.resource.data)
        && fresh(request.resource.data, 'createdAt') && rateOk()
        && !('staffPick' in request.resource.data) && !('pickedAt' in request.resource.data)
        && !('pickRejected' in request.resource.data) && !('closedReason' in request.resource.data)
        && !('rejected' in request.resource.data);
      allow update: if signedIn() && (
        // صاحب البلاغ: لا يغيّر صاحبه ولا مكتبه ولا ترشيح الموظف
        (resource.data.uid == me()
          && request.resource.data.uid == me()
          && request.resource.data.officeId == resource.data.officeId
          // v9: وقت الإنشاء لا يتغير عند التعديل (يحدد صلاحية البلاغ وترتيبه)
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('staffPick', '') == resource.data.get('staffPick', '')
          // «ليس غرضي»: يرفض صاحب البلاغ ترشيح الموظف الحالي فقط
          && (request.resource.data.get('pickRejected', '') == resource.data.get('pickRejected', '')
              || request.resource.data.get('pickRejected', '') == resource.data.get('staffPick', ''))
          // قائمة «ليس غرضي» تكبر فقط: لا يُحذف منها شيء
          && request.resource.data.get('rejected', []).hasAll(resource.data.get('rejected', []))
          // H7: أوقات التعديل والتجديد والإغلاق تُكتب بوقت «الآن» فقط
          && freshIfChanged('editedAt') && freshIfChanged('renewedAt') && freshIfChanged('closedAt')
          && validReport(request.resource.data))
        || (isStaffOf(resource.data.officeId) && onlyChanges(['staffPick', 'pickedAt']))
      );
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    match /reportPhotos/{reportId} {
      function report() { return get(/databases/$(database)/documents/reports/$(reportId)).data; }
      allow read: if signedIn() && (report().uid == me() || isStaffOf(report().officeId));
      allow create, update: if signedIn() && photoDoc() && report().uid == me();
      allow delete: if signedIn() && (report().uid == me() || isAdmin());
    }

    // طلبات الاستلام: يراها صاحبها وموظفو المكتب، ويغيّر حالتها الموظف فقط
    match /claims/{claimId} {
      allow read: if signedIn() && (resource.data.uid == me() || isStaffOf(resource.data.officeId));
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['itemId', 'officeId', 'uid', 'proof', 'color', 'brand', 'lostSpot', 'bldg', 'room', 'lostDate', 'reportId', 'claimantName', 'idLast4', 'details', 'no', 'status', 'createdAt', 'proofs', 'cat', 'grouped'])
        // v9: الطلب الجديد بلا codeHash؛ بصمة الرمز في claimCodes تُنشأ في العملية نفسها
        && existsAfter(codeDoc(claimId))
        // v7: عدد صور الإثبات المرفقة (0–2)، وحدّ الطلبات الجارية وحدّ التصنيف (claimQuota في العملية نفسها)، ونطاق بريد الكلية
        && (!('proofs' in request.resource.data) || (request.resource.data.proofs is int && request.resource.data.proofs >= 0 && request.resource.data.proofs <= 2))
        && claimId in getAfter(/databases/$(database)/documents/claimQuota/$(me())).data.open
        && domainOk(request.resource.data.officeId)
        && validDetails(request.resource.data)
        // رقم الطلب القصير (مثل REQ-7K3M) يظهر للمستخدم والموظف
        && strMax(request.resource.data, 'no', 16)
        // الاسم كما في البطاقة وآخر 4 أرقام منها: يطابقها الموظف مع البطاقة عند التسليم
        && strMax(request.resource.data, 'claimantName', 120)
        && (!('idLast4' in request.resource.data) || request.resource.data.idLast4.matches('[0-9]{4}'))
        && request.resource.data.uid == me()
        && request.resource.data.status == 'pending'
        && strMax(request.resource.data, 'proof', 5000)
        && strMax(request.resource.data, 'lostSpot', 400)
        && strMax(request.resource.data, 'color', 60) && strMax(request.resource.data, 'brand', 200)
        && strMax(request.resource.data, 'bldg', 40) && strMax(request.resource.data, 'room', 60)
        && isDay(request.resource.data, 'lostDate') && strMax(request.resource.data, 'reportId', 100)
        // H7: البلاغ المرتبط (إن وُجد) بلاغ صاحب الطلب نفسه، ووقت الإنشاء «الآن»، وحدّ الإغراق
        && (!('reportId' in request.resource.data) || request.resource.data.reportId == ''
            || get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.uid == me())
        && fresh(request.resource.data, 'createdAt') && rateOk()
        && (
          // طلب على غرض محدد: طلب واحد فقط لكل مستخدم على كل غرض (رقم الطلب = رقم الغرض_رقم المستخدم)،
          // والمحجوز يقبل طلباً منافساً: صاحبه الحقيقي يستطيع الاعتراض قبل التسليم
          (request.resource.data.get('grouped', false) == false && !('cat' in request.resource.data)
            && claimId == request.resource.data.itemId + '_' + me()
            && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.status in ['available', 'reserved']
            && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.officeId == request.resource.data.officeId)
          // v8: طلب مجمّع بالوصف: بلا غرض، لتصنيف مجمّع فقط، ورقمه g_<المستخدم>_<التصنيف>_<وقت الإنشاء>
          // (يربطه الموظف بغرض لاحقاً في claimLinks، ولا يُكتب itemId في الطلب إلا عند القبول)
          || (request.resource.data.grouped == true && request.resource.data.itemId == ''
            && request.resource.data.cat in groupCats()
            && claimId == 'g_' + me() + '_' + request.resource.data.cat + '_' + string(request.resource.data.createdAt)
            && officeExists(request.resource.data.officeId))
        );
      allow update: if (isStaffOf(resource.data.officeId)
          // فصل المهام: الموظف لا يقرر في طلب أرسله هو
          && resource.data.uid != me()
          && onlyChanges(['status', 'note', 'decidedAt', 'decidedBy', 'doneAt', 'doneBy', 'pickupBy', 'question', 'askedAt', 'askedBy', 'handoverNote', 'answer', 'answeredAt', 'proofs', 'itemId', 'handoverCode'])
          // v9: handoverCode يُكتب فقط في الانتقال إلى «مكتمل» (ولا يتغير غير ذلك)
          && (request.resource.data.get('handoverCode', '') == resource.data.get('handoverCode', '')
              || (request.resource.data.status == 'done' && resource.data.status != 'done'))
          // v8: رقم الغرض لا يتغير، إلا في الطلب المجمّع عند قبوله: يُكتب مرة واحدة = الغرض المربوط في claimLinks
          && (request.resource.data.itemId == resource.data.itemId
              || (resource.data.get('grouped', false) == true && resource.data.itemId == ''
                  && request.resource.data.status == 'approved'
                  && request.resource.data.itemId == get(linkDoc(claimId)).data.itemId))
          // v7: عدد الصور يصير 0 فقط (عند حذفها مع إغلاق الطلب). v10: حقل approvals القديم لا يُكتب بعد الآن
          && (request.resource.data.get('proofs', 0) == resource.data.get('proofs', 0) || request.resource.data.get('proofs', 0) == 0)
          // H7: الموظف لا يكتب إجابة: يحذف الإجابة القديمة فقط عند سؤال جديد (أو يتركها كما هي)
          && (!('answer' in request.resource.data) || request.resource.data.answer == resource.data.get('answer', null))
          && (!('answeredAt' in request.resource.data) || request.resource.data.answeredAt == resource.data.get('answeredAt', null))
          && request.resource.data.status in ['pending', 'approved', 'done', 'rejected', 'expired', 'cancelled']
          && (request.resource.data.status != 'approved' || resource.data.status == 'approved' || approveOk(claimId, request.resource.data.itemId))
          && (request.resource.data.status != 'done' || resource.data.status == 'done' || (doneOk(claimId, resource.data.itemId) && codeOk(claimId)))
          && strMax(request.resource.data, 'note', 600) && strMax(request.resource.data, 'question', 600)
          && strMax(request.resource.data, 'handoverNote', 600))
        // v9: «إلغاء» صاحب الطلب لطلبه قيد المراجعة (بعد سؤال الموظف لا يُحذف، فلا يُعاد إرساله لتخمين جديد)
        || (signedIn() && resource.data.uid == me() && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled' && onlyChanges(['status', 'cancelledAt'])
          && fresh(request.resource.data, 'cancelledAt'))
        // صاحب الطلب يجيب عن سؤال الموظف ما دام طلبه قيد المراجعة
        || (signedIn() && resource.data.uid == me() && resource.data.status == 'pending' && ('question' in resource.data)
          && onlyChanges(['answer', 'answeredAt'])
          && request.resource.data.answer is string && request.resource.data.answer.size() <= 2000
          // H7: وقت الإجابة «الآن» (لا رقم مستقبلي يجعل كل سؤال لاحق يبدو مُجاباً)
          && fresh(request.resource.data, 'answeredAt'))
        // «تعديل الطلب»: صاحبه يعدّل إجاباته ما دام قيد المراجعة ولم يسأله الموظف بعد
        || (signedIn() && resource.data.uid == me() && resource.data.status == 'pending' && !('question' in resource.data)
          && onlyChanges(['proof', 'color', 'brand', 'lostSpot', 'bldg', 'room', 'lostDate', 'details', 'claimantName', 'idLast4', 'editedAt'])
          && fresh(request.resource.data, 'editedAt')
          && validDetails(request.resource.data)
          && strMax(request.resource.data, 'proof', 5000) && strMax(request.resource.data, 'lostSpot', 400)
          && strMax(request.resource.data, 'color', 60) && strMax(request.resource.data, 'brand', 200)
          && strMax(request.resource.data, 'bldg', 40) && strMax(request.resource.data, 'room', 60)
          && isDay(request.resource.data, 'lostDate') && strMax(request.resource.data, 'claimantName', 120)
          && (!('idLast4' in request.resource.data) || request.resource.data.idLast4.matches('[0-9]{4}')))
        // قياس الرضا: صاحب الطلب المكتمل يقيّمه مرة واحدة (1–5 وتعليق اختياري)
        || (signedIn() && resource.data.uid == me() && resource.data.status == 'done' && !('rating' in resource.data)
          && onlyChanges(['rating', 'ratingNote', 'ratedAt'])
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && strMax(request.resource.data, 'ratingNote', 300) && freshIfChanged('ratedAt'))
        // «حذف حسابي»: الطلب المنتهي لا يُحذف، بل تُمسح منه بيانات صاحبه ويبقى السجل للمكتب
        // (المرفوض يبقى حتى لا يُحذف ويُعاد إرساله لتخمين التفاصيل من جديد)
        || (signedIn() && resource.data.uid == me() && resource.data.status in ['done', 'rejected', 'expired', 'cancelled']
          && request.resource.data.uid == 'deleted' && request.resource.data.proof == ''
          && onlyChanges(['uid', 'proof', 'color', 'brand', 'lostSpot', 'bldg', 'room', 'lostDate', 'answer', 'claimantName', 'idLast4', 'handoverNote', 'details', 'ratingNote', 'anonymizedAt']));
      // يحذف المستخدم طلبه ما دام قيد المراجعة، ولم يسأله الموظف (v10: شرط الموافقة الأولى أُلغي)؛ غير ذلك «إلغاء» بالأعلى
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == me() && resource.data.status == 'pending'
            && !('question' in resource.data));
    }

    // إشعار تسليم: من وجد غرضاً يسجّله قبل أن يسلّمه، ويؤكد الموظف استلامه ويحوّله إلى غرض في المستودع
    match /foundReports/{reportId} {
      allow read: if signedIn() && (resource.data.uid == me() || isStaffOf(resource.data.officeId));
      allow create: if verified()
        && request.resource.data.uid == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['officeId', 'uid', 'cat', 'sub', 'spot', 'bldg', 'room', 'foundDate', 'note', 'code', 'status', 'createdAt'])
        && strMax(request.resource.data, 'code', 12)
        && request.resource.data.officeId is string
        // H7: المكتب موجود، والتصنيف نص قصير، وتاريخ العثور يوم صالح، ووقت الإنشاء «الآن»، وحدّ الإغراق
        && officeExists(request.resource.data.officeId) && catOk(request.resource.data)
        && isDay(request.resource.data, 'foundDate') && fresh(request.resource.data, 'createdAt') && rateOk()
        && strMax(request.resource.data, 'cat', 40) && strMax(request.resource.data, 'sub', 200)
        && strMax(request.resource.data, 'spot', 400) && strMax(request.resource.data, 'bldg', 40)
        && strMax(request.resource.data, 'room', 60)
        && strMax(request.resource.data, 'note', 2000);
      allow update: if
        // صاحب الإشعار يلغيه ما دام لم يُسلَّم
        (signedIn() && resource.data.uid == me() && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled' && onlyChanges(['status', 'cancelledAt']) && freshIfChanged('cancelledAt'))
        // «حذف حسابي»: الإشعار المستلَم يبقى للمكتب دون بيانات صاحبه
        || (signedIn() && resource.data.uid == me() && resource.data.status == 'received'
          && request.resource.data.uid == 'deleted' && request.resource.data.note == '' && onlyChanges(['uid', 'note']))
        // الموظف يؤكد الاستلام ويربطه بالغرض
        || (isStaffOf(resource.data.officeId) && onlyChanges(['status', 'receivedAt', 'receivedBy', 'itemId'])
          && request.resource.data.status in ['pending', 'received', 'cancelled']
          // v9: من استلم = الموظف الذي يكتب الآن
          && (request.resource.data.get('receivedBy', '') == resource.data.get('receivedBy', '') || request.resource.data.receivedBy == me())
          && strMax(request.resource.data, 'itemId', 100));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == me() && resource.data.status != 'received');
    }

    // مؤشرات المكتب للزوار (شفافية): أرقام مجمّعة فقط، يكتبها جهاز موظف المكتب عند فتح الإحصاءات
    match /publicStats/{officeId} {
      allow read: if true;
      allow write: if isStaffOf(officeId)
        && request.resource.data.keys().hasOnly(['month', 'monthReceived', 'monthReturned', 'totalReceived', 'totalReturned',
                                                  'returnRate', 'avgDays', 'avgRating', 'ratings', 'updatedAt'])
        && strMax(request.resource.data, 'month', 7)
        && request.resource.data.get('monthReceived', 0) is number && request.resource.data.get('monthReturned', 0) is number
        && request.resource.data.get('totalReceived', 0) is number && request.resource.data.get('totalReturned', 0) is number
        && request.resource.data.get('returnRate', 0) is number
        && request.resource.data.get('returnRate', 0) >= 0 && request.resource.data.get('returnRate', 0) <= 100
        && request.resource.data.get('avgDays', 0) is number && request.resource.data.get('avgRating', 0) is number
        && request.resource.data.get('ratings', 0) is number && request.resource.data.get('updatedAt', 0) is number;
    }

    // سجل العمليات (سلسلة الحيازة): يُضاف إليه فقط، ولا يُعدَّل
    match /logs/{logId} {
      allow read: if isStaffOf(resource.data.officeId);
      allow create: if (isStaffOf(request.resource.data.officeId)
          // قبول الدعوة: قيد «منح الصلاحية» يكتبه الموظف الجديد عن نفسه في الـ batch نفسه
          // (قبل العملية ليس موظفاً، وبعدها صار موظفاً في هذا المكتب، والدعوة موجودة قبل حذفها)
          || (request.resource.data.action == 'perm:grant' && request.resource.data.note == me()
            && request.resource.data.itemId == '' && invited()
            && !exists(/databases/$(database)/documents/staff/$(me()))
            && request.resource.data.officeId in getAfter(/databases/$(database)/documents/staff/$(me())).data.offices))
        && request.resource.data.by == me()
        // v9: وقت القيد «الآن» (لا تاريخ مزوّر في سلسلة الحيازة)
        && fresh(request.resource.data, 'at')
        && request.resource.data.keys().hasOnly(['officeId', 'itemId', 'claimId', 'reportId', 'action', 'by', 'at', 'note', 'checks'])
        // v7: فحوص التسليم التي علّمها الموظف (مفاتيح نصوص فقط، بلا بيانات شخصية)
        && (!('checks' in request.resource.data) || (request.resource.data.checks is list && request.resource.data.checks.size() <= 10))
        && request.resource.data.action is string && request.resource.data.action.size() <= 40
        && request.resource.data.at is number
        && strMax(request.resource.data, 'itemId', 100) && strMax(request.resource.data, 'claimId', 200)
        && strMax(request.resource.data, 'reportId', 100) && strMax(request.resource.data, 'note', 600);
      allow update: if false;
      // H7: سجل الحيازة لا يُمحى من التطبيق أبداً (التنظيف من Firebase Console فقط)
      allow delete: if false;
    }

    // v7: حدّ «الصيد»: قائمة طلبات الاستلام الجارية لكل حساب (3 على الأكثر في كل المكاتب) ووقت آخر طلب لكل تصنيف (واحد كل 24 ساعة).
    // تُحدَّث في العملية نفسها مع إنشاء الطلب (الإضافة لصاحبها فقط). الإزالة لأي حساب بشرط أن يكون الطلب قد أُغلق أو حُذف فعلاً،
    // فلا يستطيع أحد تفريغ القائمة دون إغلاق طلباته
    match /claimQuota/{userId} {
      function qa() { return request.resource.data; }
      function lb(d) { return d.get('lastByCat', {}); }
      function cAfter(id) { return getAfter(claimDoc(id)).data; }
      function gone(id) { return !existsAfter(claimDoc(id)) || cAfter(id).status in ['done', 'rejected', 'expired', 'cancelled']; }
      // v8: تصنيف الطلب المجمّع مكتوب فيه (بلا غرض)، وتصنيف الطلب العادي من غرضه
      function catOf(id) { return cAfter(id).get('grouped', false) == true ? cAfter(id).cat : get(/databases/$(database)/documents/items/$(cAfter(id).itemId)).data.cat; }
      // bOpen / bLb: القائمة ووقت آخر طلب لكل تصنيف قبل العملية (فارغة عند الإنشاء الأول)
      function addOk(bOpen, bLb, id) {
        return userId == me() && qa().open.size() <= 3
          && !exists(claimDoc(id)) && existsAfter(claimDoc(id)) && cAfter(id).uid == me()
          && lb(qa()).diff(bLb).affectedKeys().hasOnly([catOf(id)])
          && lb(qa())[catOf(id)] == request.time
          && (!(catOf(id) in bLb) || bLb[catOf(id)] < request.time - duration.value(24, 'h'));
      }
      function removeOk(rem) {
        return rem.size() <= 3
          && (rem.size() < 1 || gone(rem[0]))
          && (rem.size() < 2 || gone(rem[1]))
          && (rem.size() < 3 || gone(rem[2]));
      }
      function quotaOk(bOpen, bLb) {
        return qa().keys().hasOnly(['open', 'lastByCat']) && qa().open is list && lb(qa()) is map
          && (
            // إضافة: صاحب الحساب ينشئ طلباً جديداً الآن (لا أكثر من 3 جارية، ولا طلبين في التصنيف نفسه خلال 24 ساعة)
            (qa().open.removeAll(bOpen).size() == 1 && bOpen.removeAll(qa().open).size() == 0
              && addOk(bOpen, bLb, qa().open.removeAll(bOpen)[0]))
            // إزالة: طلبات أُغلقت أو حُذفت في العملية نفسها (الموظف عند القرار، أو صاحب الطلب عند حذف حسابه)
            || (qa().open.removeAll(bOpen).size() == 0 && lb(qa()) == bLb && removeOk(bOpen.removeAll(qa().open)))
          );
      }
      allow read: if signedIn() && userId == me();
      allow create: if signedIn() && quotaOk([], {});
      allow update: if signedIn() && quotaOk(resource.data.open, lb(resource.data));
      allow delete: if false;
    }

    // v7: صور إثبات اختيارية لطلب الاستلام (صورة قديمة للغرض أو فاتورته، صورتان على الأكثر): claimProofs/{claimId}_{0|1}.
    // يراها صاحب الطلب وموظفو المكتب فقط، ولا تظهر في أي صفحة عامة. تُحذف مع إغلاق الطلب
    // v9 (H12): بصمة رمز الاستلام: لا يقرؤها أحد (ولا صاحبها)، ولا تُعدَّل ولا تُحذف.
    // ينشئها صاحب الطلب في عملية إنشاء الطلب نفسها (الطلب غير موجود قبلها، وله بعدها)
    match /claimCodes/{claimId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'hash'])
        && request.resource.data.uid == me()
        && request.resource.data.hash is string && request.resource.data.hash.size() == 64
        && !exists(claimDoc(claimId)) && getAfter(claimDoc(claimId)).data.uid == me();
      allow update, delete: if false;
    }

    // v8 (H11): ربط الطلب المجمّع بغرض: للموظفين فقط (صاحب الطلب لا يرى الغرض ولا المرشّحين قبل القبول)
    // موظف المكتب يربطه مرة واحدة (لا تعديل)، بغرض متاح من المكتب والتصنيف نفسيهما، وليس في طلب أرسله هو
    match /claimLinks/{claimId} {
      function cl() { return get(claimDoc(claimId)).data; }
      function it() { return get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data; }
      allow read: if isStaffOf(resource.data.officeId);
      allow create: if isStaffOf(request.resource.data.officeId)
        && request.resource.data.keys().hasOnly(['officeId', 'itemId', 'by', 'at'])
        && request.resource.data.by == me() && fresh(request.resource.data, 'at')
        && request.resource.data.itemId is string && request.resource.data.itemId.size() > 0 && request.resource.data.itemId.size() <= 100
        && cl().get('grouped', false) == true && cl().itemId == '' && cl().status == 'pending'
        && cl().officeId == request.resource.data.officeId && cl().uid != me()
        && it().officeId == request.resource.data.officeId && it().cat == cl().cat && it().status == 'available';
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /claimProofs/{proofId} {
      allow read: if signedIn() && (resource.data.uid == me() || isStaffOf(resource.data.officeId));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['claimId', 'officeId', 'uid', 'data', 'createdAt'])
        && request.resource.data.uid == me() && smallImage()
        && fresh(request.resource.data, 'createdAt')
        && (proofId == request.resource.data.claimId + '_0'
            || (proofId == request.resource.data.claimId + '_1' && getAfter(claimDoc(request.resource.data.claimId)).data.get('proofs', 0) >= 2))
        && getAfter(claimDoc(request.resource.data.claimId)).data.uid == me()
        && getAfter(claimDoc(request.resource.data.claimId)).data.officeId == request.resource.data.officeId
        && getAfter(claimDoc(request.resource.data.claimId)).data.get('proofs', 0) >= 1;
      allow update: if false;
      allow delete: if isAdmin()
        // صاحب الطلب قبل قرار الموظف (أو مع حذف الطلب نفسه)
        || (signedIn() && resource.data.uid == me()
            && (!existsAfter(claimDoc(resource.data.claimId)) || getAfter(claimDoc(resource.data.claimId)).data.status in ['pending', 'cancelled']))
        // الموظف عند إغلاق الطلب (تسليم أو رفض أو إلغاء أو انتهاء) في العملية نفسها
        || (isStaffOf(resource.data.officeId)
            && (!existsAfter(claimDoc(resource.data.claimId))
                || getAfter(claimDoc(resource.data.claimId)).data.status in ['done', 'rejected', 'expired', 'cancelled']));
    }

    // H7: حدّ الإغراق: وثيقة لكل حساب فيها وقت آخر إنشاء (وقت الخادم فقط). لا تُحذف قبل مرور 20 ثانية،
    // حتى لا يتجاوز أحد الحدّ بحذفها ثم الإنشاء مباشرة
    match /rate/{userId} {
      allow read: if signedIn() && userId == me();
      allow create, update: if signedIn() && userId == me()
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow delete: if signedIn() && userId == me() && resource.data.at < request.time - duration.value(20, 's');
    }

    // صلاحيات الموظفين: يمنحها ويسحبها المالك فقط
    match /staff/{userId} {
      allow read: if signedIn() && (userId == me() || isAdmin());
      // قبول الدعوة: المدعو ينشئ وثيقته بنفسه مرة واحدة، ببريد موثّق ودعوة موجودة، وبمكاتب الدعوة نفسها تماماً
      allow create: if isAdmin() || (signedIn() && userId == me() && invited()
        && request.resource.data.keys().hasOnly(['offices', 'approvedAt', 'approvedBy'])
        && request.resource.data.offices == get(inviteDoc()).data.offices
        && request.resource.data.approvedBy == get(inviteDoc()).data.createdBy
        && request.resource.data.approvedAt is number);
      // أي تعديل آخر أو سحب للصلاحية: للإدارة فقط
      allow update, delete: if isAdmin();
    }

    // دعوات الموظفين: تكتبها الإدارة فقط (البريد بأحرف صغيرة معرّفاً)، ويقرأ المدعو دعوته فقط ببريده الموثّق
    match /staffInvites/{email} {
      allow read: if isAdmin() || (hasEmail() && email == myEmail());
      allow create, update: if isAdmin() && email == email.lower()
        && request.resource.data.keys().hasOnly(['offices', 'createdBy', 'createdAt'])
        && request.resource.data.offices is list && request.resource.data.offices.size() > 0 && request.resource.data.offices.size() <= 50
        && request.resource.data.createdBy == me() && request.resource.data.createdAt is number;
      // الإدارة تلغي الدعوة. والمدعو يحذفها فقط في عملية القبول نفسها (وثيقة staff له بمكاتب الدعوة نفسها في الـ batch)
      allow delete: if isAdmin() || (hasEmail() && email == myEmail()
        && getAfter(/databases/$(database)/documents/staff/$(me())).data.offices == resource.data.offices);
    }

    // طلبات الصلاحية القديمة (أُلغيت؛ الموظفون يُدعون الآن من الإدارة): لا إنشاء ولا تعديل إلا للإدارة،
    // والقراءة والحذف كما كانت حتى ينظّف المالك الطلبات القديمة
    match /staffRequests/{userId} {
      allow read: if signedIn() && (userId == me() || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if signedIn() && (userId == me() || isAdmin());
    }
  }
}
